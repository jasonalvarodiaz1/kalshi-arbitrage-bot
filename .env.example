# Kalshi API Credentials (optional - only needed for authenticated features)
KALSHI_EMAIL=your-email@example.com
KALSHI_PASSWORD=your-password
KALSHI_API_KEY=your_api_key_here

# Bot Configuration
MIN_PROFIT_PERCENT=1.0
MIN_ORDER_QUANTITY=5
SCAN_INTERVAL_SECONDS=60
PAPER_TRADING=true
# Live trading safety (default disabled)
# Set to true only after you review code and understand risks
ENABLE_LIVE_TRADING=false
# Maximum USD value for a single arbitrage trade (safety cap)
MAX_TRADE_USD=100.0

# Notifications (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_EMAIL=
WEBHOOK_URL=
# Notification mode: immediate | digest | critical | mute
# Digest mode aggregates alerts and sends a summary every N minutes
NOTIFICATION_MODE=digest
NOTIFICATION_SUMMARY_INTERVAL_MIN=120

# Filtering
MIN_EXPIRY_MINUTES=30

# Position Limits
MAX_POSITIONS=10
MAX_EXPOSURE_USD=500.0

# Exposure Limits
MAX_EVENT_EXPOSURE_PCT=20.0
MAX_CATEGORY_EXPOSURE_PCT=40.0

# Probability Trading Configuration
# Minimum edge required to take a probability trade (in percentage points)
MIN_EDGE_PERCENT=3.0
# Kelly multiplier (0.5 = half-Kelly, recommended conservative setting)
KELLY_MULTIPLIER=0.5
# BTC 15-minute realized volatility estimate
BTC_15MIN_VOL=0.004
# ETH 15-minute realized volatility estimate
ETH_15MIN_VOL=0.005
# Price feed cache time-to-live in seconds
PRICE_CACHE_SECONDS=10

# ── Polymarket Configuration ──────────────────────────────────────────────────
# API key for Polymarket CLOB (optional for read-only market data)
POLYMARKET_API_KEY=
# Ethereum private key for order signing (optional, reserved for future trading)
POLYMARKET_PRIVATE_KEY=
# Set to false to disable Polymarket scanning entirely
POLYMARKET_ENABLED=true

# ── Cross-platform Arbitrage ──────────────────────────────────────────────────
# Minimum profit percentage required to report a cross-platform opportunity
# 5% covers fees + spread on both legs (Kalshi ~7bps + Polymarket 2% + slippage)
CROSS_PLATFORM_MIN_PROFIT_PERCENT=5.0
# Title similarity threshold for matching Kalshi ↔ Polymarket markets (0–1)
MATCH_SIMILARITY_THRESHOLD=0.85
# Categories to match for cross-platform arb (US users limited to sports,politics)
# Set to 'all' to disable filtering (non-US users)
POLYMARKET_CATEGORIES=sports,politics
# Max hours between Kalshi and Polymarket settlement dates to consider a valid match
# Lower = stricter (avoids matching same-name markets with different expiries)
CROSS_PLATFORM_MAX_EXPIRY_DIFF_HOURS=48

# ── Polymarket Sports Arbitrage (same-event multi-outcome arb) ────────────────
# Polymarket charges 2% on winning payouts (effective payout = 98¢ per $1)
POLYMARKET_FEE_PERCENT=2.0
# Min profit after 2% fee. 0.5% is too tight — execution slippage alone eats that.
# 2% leaves a real margin after both legs execute.
POLYMARKET_SPORTS_MIN_PROFIT_PERCENT=2.0
# Seconds between scans (30-60s recommended, matching the $619K bot)
POLYMARKET_SPORTS_SCAN_INTERVAL=45
# Max USD per side. Start conservative ($500) and scale after live validation.
# The $619K bot used $3K-$9K but was battle-tested with sub-second latency.
POLYMARKET_SPORTS_MAX_POSITION_USD=500

# ─── Manifold Markets ───────────────────────────────────────────────
# Get your API key: https://manifold.markets/profile (API tab)
MANIFOLD_API_KEY=
MANIFOLD_ENABLED=true
MANIFOLD_SWEEPSTAKES_ONLY=true       # Only scan Sweepcash markets (real money)
MANIFOLD_MIN_PROFIT_PERCENT=3.0      # Min cross-platform edge (no fees, but AMM slippage)
MANIFOLD_SCAN_INTERVAL=90            # Seconds between scans (AMM prices move slowly)
MANIFOLD_MAX_BET_USD=50              # Max per bet (liquidity is thin — start small)
MANIFOLD_CATEGORIES=all              # 'all', 'politics', 'sports', 'crypto', etc.

# ── WS Convergence Trader Kill Switches ──────────────────────────────────────
# Disable weather trading (42% WR, no model edge — disabled by default)
DISABLE_WEATHER=true

# Disable binary 15-minute markets (22% WR, model fails — disabled by default)
DISABLE_BINARY_15M=true

# ── WebSocket Price Feed (Binance, no API key required) ───────────────────────
# Enable real-time BTC/ETH price feed via Binance public WebSocket
WS_PRICE_FEED_ENABLED=true
# Maximum reconnect delay in seconds (exponential back-off capped at this value)
WS_RECONNECT_MAX_DELAY=30
